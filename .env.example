# Same Supabase project as nigarbapp -- copy these two values from that
# project's .env.local so member accounts work across both apps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# New secret for this project: any random string, used to salt the hashed
# voter ID stored in vote_receipts/vote_audit_log so it can't be reversed
# by brute-forcing known member UUIDs. Generate with: openssl rand -hex 32
VOTE_HASH_SALT=

# Same Resend account as nigarbapp -- copy from that project's .env.local.
# Used to email the vote receipt right after a vote is cast. Without this,
# voting still works, the email is just skipped (logged, not thrown).
RESEND_API_KEY=
RESEND_FROM_EMAIL="NCAA Voting <noreply@ncaaweb.com.ng>"

# Used to build the verification link in the receipt email. Defaults to
# the production URL if unset.
NEXT_PUBLIC_APP_URL=https://vote.ncaaweb.com.ng

# Optional -- only needed if/when web push notifications are wired up for
# this app. Leave unset to skip; lib/push-notifications.ts no-ops without
# them.
VAPID_SUBJECT=mailto:admin@ncaaweb.com.ng
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
